{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.leadxmedia/leadxmedia-mcp",
  "title": "LeadXMedia",
  "description": "Affiliate program data and actions from LeadXMedia. No tool can send money.",
  "websiteUrl": "https://leadxmedia.com/docs/mcp/",
  "repository": {
    "url": "https://github.com/leadxmedia/leadxmedia",
    "source": "github",
    "id": "1448241306",
    "subfolder": "packages/mcp"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "leadxmedia-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LEADXMEDIA_API_KEY",
          "description": "API key from Settings > API & webhooks",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LEADXMEDIA_URL",
          "description": "Your LeadXMedia URL (defaults to https://app.leadxmedia.com)",
          "isRequired": false,
          "default": "https://app.leadxmedia.com"
        },
        {
          "name": "LEADXMEDIA_MCP_WRITE",
          "description": "Set to true to turn on write tools. No tool can send money.",
          "isRequired": false,
          "default": "false"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.leadxmedia.com/mcp"
    }
  ]
}
